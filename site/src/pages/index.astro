---
import BaseLayout from "../layouts/BaseLayout.astro";
import { standards } from "../data/standards";
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-title">
    <img class="hero-image" src="/assets/governance-hero.png" alt="Modular governance controls and repositories arranged as connected infrastructure" />
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="hero-content">
      <p class="eyebrow">Governancecommons.org</p>
      <h1 id="hero-title">Governance Commons</h1>
      <p class="hero-copy">Four interoperable, project-neutral standards for governed AI agent systems: identity, coordination, canonical naming, and runtime orchestration.</p>
      <div class="actions">
        <a class="button primary" href="#standards">Explore standards</a>
        <a class="button secondary" href="/conformance">Declare conformance</a>
      </div>
    </div>
    <aside class="hero-panel" aria-label="Governance Commons release summary">
      <div><span class="metric">4</span><span class="metric-label">portable standards</span></div>
      <div><span class="metric">v1.2.0</span><span class="metric-label">release train</span></div>
      <div><span class="metric">3</span><span class="metric-label">conformance profiles</span></div>
    </aside>
  </section>

  <section class="section">
    <div class="section-heading">
      <p class="eyebrow">Public release</p>
      <h2>Governance Commons v1.2.0 establishes the frozen OSS baseline.</h2>
      <p>PASS-5 closes the first public release boundary while preserving room for optional category-defining profiles in PASS-6.</p>
    </div>
    <div class="actions" style="margin-top:24px">
      <a class="button ink" href="/release">Read the release &amp; baseline notice</a>
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <p class="eyebrow">The commons</p>
      <h2>Governance contracts that travel with the work.</h2>
    </div>
    <div class="intro-grid">
      <article class="surface"><h3>Independently versioned</h3><p>Adopt one standard or the full stack. Every specification keeps its own schema, release cadence, examples, and compatibility contract.</p></article>
      <article class="surface"><h3>Project-neutral</h3><p>Use portable contracts without importing project-specific business logic or committing to one orchestration runtime.</p></article>
      <article class="surface"><h3>Evidence-oriented</h3><p>Make authority, routing, handoffs, validation, telemetry, and recovery visible enough to review after the work is done.</p></article>
    </div>
  </section>

  <section id="standards" class="section white">
    <div class="section-heading">
      <p class="eyebrow">Standards</p>
      <h2>The four layers of governed agent software.</h2>
    </div>
    <div class="standards-grid">
      {standards.map((standard) => (
        <article class="surface standard-card">
          <div class="standard-topline"><span>{standard.status}</span><span>v{standard.version}</span></div>
          <h3>{standard.name}</h3>
          <p>{standard.scope}</p>
          <p class="standard-detail">{standard.summary}</p>
          <div class="standard-footer"><code>{standard.shortName}</code><a class="text-link" href={`/standards/${standard.slug}`}>View standard →</a></div>
        </article>
      ))}
    </div>
  </section>

  <section id="adopt" class="section tint">
    <div class="section-heading">
      <p class="eyebrow">Adopt</p>
      <h2>Move from a specification to a verifiable declaration.</h2>
    </div>
    <div class="adopt-grid">
      <article class="surface"><span class="step">01</span><h3>Select</h3><p>Choose the standards and pinned versions your system actually implements.</p></article>
      <article class="surface"><span class="step">02</span><h3>Validate</h3><p>Run the source validators and retain the report required by your profile.</p></article>
      <article class="surface"><span class="step">03</span><h3>Declare</h3><p>Publish the matching badge and add your project to the adopter registry.</p></article>
    </div>
    <div class="actions" style="justify-content:center; margin-top:30px"><a class="button ink" href="/conformance">Conformance profiles and badges</a></div>
  </section>

  <section class="section contact-section">
    <div class="contact-copy"><p class="eyebrow">Governance Commons</p><h2>A commons of portable specifications, not a single runtime.</h2><p>Use the standards separately or as a layered governance stack for agent delivery, assurance, naming, coordination, and project orchestration.</p></div>
    <div class="contact-actions"><a class="button primary" href="https://github.com/governancecommons">Browse repositories</a></div>
  </section>
</BaseLayout>
