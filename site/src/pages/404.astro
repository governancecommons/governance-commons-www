---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Page not found | Governance Commons" description="The Governance Commons page you requested could not be found.">
  <section class="section white" style="padding-top:150px;min-height:60vh">
    <div class="section-heading">
      <p class="eyebrow">404 · Page not found</p>
      <h1>That page isn't here.</h1>
      <p>The address may have changed, or the page may not exist. You can return to the public homepage or find published specifications and evidence below.</p>
      <div class="actions" style="margin-top:24px">
        <a class="button primary" href="/">Return home</a>
        <a class="button secondary" href="/#components">Explore components</a>
        <a class="button secondary" href="/release">Release status</a>
      </div>
    </div>
  </section>
</BaseLayout>
