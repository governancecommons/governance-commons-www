{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governancecommons.org/agent-matrix/v/1.5.0/schemas/sections/cloudevents-binding.schema.json",
  "title": "CloudEvents Binding",
  "description": "CloudEvents 1.0 binding for agent matrix signals. Full 5/5 depth: 5 event type schemas, delivery semantics (at-least-once), ordering/causality rules, W3C trace-context, and idempotency key strategy.",
  "type": "object",
  "required": ["specversion", "event_source", "content_type", "event_type_mappings", "delivery", "delivery_semantics", "ordering_causality", "trace_context", "idempotency"],
  "additionalProperties": false,
  "properties": {
    "specversion": { "type": "string" },
    "event_source": { "type": "string" },
    "content_type": { "type": "string" },
    "subject_template": { "type": "string" },
    "id_strategy": {
      "type": "string",
      "enum": ["uuid-v7", "uuid-v4", "trace-event-id", "deterministic-hash"]
    },
    "time_source": {
      "type": "string",
      "enum": ["event-created-at", "emission-time"]
    },
    "event_type_mappings": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["matrix_signal", "cloudevents_type", "data_schema"],
        "additionalProperties": false,
        "properties": {
          "matrix_signal": { "type": "string" },
          "cloudevents_type": { "type": "string" },
          "data_schema": { "type": "string" },
          "required_extensions": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["string", "integer", "number", "boolean"] },
          "required": { "type": "boolean" }
        }
      }
    },
    "delivery": {
      "type": "object",
      "required": ["mode", "targets", "retry_policy"],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["http-binary", "http-structured", "kafka", "pubsub", "eventbridge"]
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "uri"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "uri": { "type": "string" },
              "enabled": { "type": "boolean" }
            }
          }
        },
        "retry_policy": {
          "type": "object",
          "required": ["max_attempts", "backoff"],
          "additionalProperties": false,
          "properties": {
            "max_attempts": { "type": "integer", "minimum": 0 },
            "backoff": { "type": "string", "enum": ["none", "linear", "exponential"] },
            "dead_letter_target": { "type": "string" }
          }
        }
      }
    },
    "delivery_semantics": {
      "type": "object",
      "required": ["guarantee", "rules"],
      "additionalProperties": false,
      "properties": {
        "guarantee": {
          "type": "string",
          "enum": ["at-least-once", "at-most-once", "exactly-once"],
          "description": "Delivery guarantee. MUST be at-least-once for this binding."
        },
        "description": { "type": "string" },
        "rules": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "ordering_causality": {
      "type": "object",
      "required": ["causation_extension", "rules"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "causation_extension": {
          "type": "object",
          "required": ["name", "type", "description", "required"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "type": { "type": "string" },
            "description": { "type": "string" },
            "required": { "type": "boolean" }
          }
        },
        "sequence_extension": {
          "type": "object",
          "required": ["name", "type", "description", "required"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "type": { "type": "string" },
            "description": { "type": "string" },
            "required": { "type": "boolean" }
          }
        },
        "rules": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "trace_context": {
      "type": "object",
      "required": ["w3c_traceparent", "gc_traceid_mapping", "rules"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "w3c_traceparent": {
          "type": "object",
          "required": ["extension_name", "type", "format", "example", "description", "required_in_strict_profile"],
          "additionalProperties": false,
          "properties": {
            "extension_name": { "type": "string" },
            "type": { "type": "string" },
            "format": { "type": "string" },
            "example": { "type": "string" },
            "description": { "type": "string" },
            "required_in_strict_profile": { "type": "boolean" }
          }
        },
        "w3c_tracestate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "extension_name": { "type": "string" },
            "type": { "type": "string" },
            "description": { "type": "string" },
            "required": { "type": "boolean" }
          }
        },
        "gc_traceid_mapping": { "type": "object" },
        "rules": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "idempotency": {
      "type": "object",
      "required": ["key_strategy", "dedup_window_seconds", "producer_id_strategy", "rules"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "key_strategy": {
          "type": "object",
          "required": ["primary_key", "key_composition"],
          "additionalProperties": false,
          "properties": {
            "primary_key": { "type": "string" },
            "description": { "type": "string" },
            "key_composition": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            },
            "description_of_uniqueness": { "type": "string" }
          }
        },
        "dedup_window_seconds": { "type": "integer", "minimum": 1 },
        "producer_id_strategy": {
          "type": "object",
          "required": ["preferred", "format", "example"],
          "additionalProperties": false,
          "properties": {
            "preferred": { "type": "string" },
            "description": { "type": "string" },
            "format": { "type": "string" },
            "example": { "type": "string" }
          }
        },
        "rules": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  }
}
