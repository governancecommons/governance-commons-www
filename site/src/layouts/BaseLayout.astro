---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Governance Commons | Sociotechnical Governance for Human–AI Systems",
  description = "A maintainer-led commons for specifications, evidence, tooling, research, education, and community work on governed human–AI and multi-agent systems.",
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="https://governancecommons.org/assets/governance-hero.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://governancecommons.org/assets/governance-hero.png" />
    <link rel="icon" type="image/svg+xml" href="/assets/governance-commons-mark.svg" />
  </head>
  <body>
    <a class="skip-to-content" href="#main-content">Skip to main content</a>
    <header class="site-header" data-elevate>
      <a class="brand" href="/" aria-label="Governance Commons home">
        <img class="brand-mark" src="/assets/governance-commons-mark.svg" alt="" width="48" height="48" />
        <span class="brand-name"><span>Governance</span> <strong>Commons</strong></span>
      </a>
      <nav class="site-nav" aria-label="Primary navigation">
        <a href="/#components">Components</a>
        <a href="/#commons">Commons</a>
        <a href="/about">About</a>
        <a href="/ecosystem">Ecosystem</a>
        <a href="/observatory">Observatory</a>
        <a href="/conformance">Conformance</a>
        <a href="/#adopt">Adopt</a>
      </nav>
      <a class="header-action" href="https://github.com/governancecommons">GitHub</a>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} Governance Commons · <a href="/about">About</a></span>
      <span>Specifications, evidence, tooling, and public learning for governed human–AI systems</span>
    </footer>
    <style>
      .skip-to-content { position: absolute; left: 1rem; top: -10rem; z-index: 1000; padding: .75rem 1rem; background: #fff; color: #002244; border: 2px solid #002244; }
      .skip-to-content:focus { top: 1rem; }
    </style>
    <script>
      const header = document.querySelector("[data-elevate]");
      const updateHeader = () => header?.classList.toggle("is-elevated", window.scrollY > 8);
      updateHeader();
      window.addEventListener("scroll", updateHeader, { passive: true });
    </script>
  </body>
</html>
