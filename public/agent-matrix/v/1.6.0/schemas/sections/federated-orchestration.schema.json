{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governancecommons.org/agent-matrix/v/1.4.0/schemas/sections/federated-orchestration.schema.json",
  "title": "Federated Orchestration",
  "description": "Multi-orchestrator topology, authority partitioning, leadership, cross-cluster handoff, and data residency.",
  "type": "object",
  "required": ["topology", "authority_model", "leadership", "cross_cluster_handoff"],
  "additionalProperties": false,
  "properties": {
    "topology": {
      "type": "object",
      "required": ["mode", "clusters"],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["single-primary", "active-active", "regional-federation"]
        },
        "clusters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["cluster_id", "region", "authority_scope"],
            "additionalProperties": false,
            "properties": {
              "cluster_id": { "type": "string" },
              "region": { "type": "string" },
              "authority_scope": { "type": "string" },
              "data_residency_zone": { "type": "string" }
            }
          }
        }
      }
    },
    "authority_model": {
      "type": "object",
      "required": ["task_graph_owner", "conflict_resolution"],
      "additionalProperties": false,
      "properties": {
        "task_graph_owner": { "type": "string" },
        "conflict_resolution": {
          "type": "string",
          "enum": ["primary-wins", "highest-trust-wins", "human-arbitration", "lease-token"]
        },
        "lease_ttl_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "leadership": {
      "type": "object",
      "required": ["election_required", "failover_policy"],
      "additionalProperties": false,
      "properties": {
        "election_required": { "type": "boolean" },
        "mechanism": {
          "type": "string",
          "enum": ["lease-lock", "raft", "external-control-plane", "none"]
        },
        "failover_policy": { "type": "string" },
        "heartbeat_interval_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "cross_cluster_handoff": {
      "type": "object",
      "required": ["allowed", "required_fields", "verification_required"],
      "additionalProperties": false,
      "properties": {
        "allowed": { "type": "boolean" },
        "required_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "verification_required": { "type": "boolean" },
        "handoff_timeout_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "data_residency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enforced": { "type": "boolean" },
        "policy_field": { "type": "string" },
        "violation_action": { "type": "string" }
      }
    }
  }
}
