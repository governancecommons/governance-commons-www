{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governancecommons.org/agent-matrix/v/1.4.0/schemas/sections/failure-modes.schema.json",
  "title": "Agent Failure Modes",
  "type": "object",
  "required": ["classification", "severity_definitions"],
  "additionalProperties": false,
  "properties": {
    "classification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "severity",
          "recoverable",
          "default_recovery"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^FM-[0-9]{3,}$"
          },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"]
          },
          "recoverable": { "type": "boolean" },
          "default_recovery": { "type": "string" }
        }
      }
    },
    "severity_definitions": {
      "type": "object",
      "required": ["low", "medium", "high", "critical"],
      "additionalProperties": false,
      "properties": {
        "low": { "type": "string" },
        "medium": { "type": "string" },
        "high": { "type": "string" },
        "critical": { "type": "string" }
      }
    }
  }
}
