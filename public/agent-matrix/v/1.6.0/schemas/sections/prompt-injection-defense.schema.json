{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governancecommons.org/agent-matrix/v/1.5.0/schemas/sections/prompt-injection-defense.schema.json",
  "title": "PromptInjectionDefense",
  "description": "JSON Schema for the prompt_injection_defense section of the agent-matrix (GC-3-B-05). Covers attack taxonomy, detection hook contract, rejection rules, and audit obligations.",
  "type": "object",
  "required": [
    "attack_taxonomy",
    "detection_hook_contract",
    "rejection_rules",
    "audit_obligations"
  ],
  "additionalProperties": true,
  "properties": {
    "description": {
      "type": "string"
    },
    "attack_taxonomy": {
      "type": "object",
      "required": ["categories"],
      "additionalProperties": true,
      "properties": {
        "description": { "type": "string" },
        "categories": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "required": ["id", "name", "description", "trust_boundary", "severity", "detection_signal", "mitigations"],
            "additionalProperties": true,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^INJECT-[0-9]{2}$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "trust_boundary": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "type": "string",
                "enum": ["low", "medium", "high", "critical"]
              },
              "detection_signal": {
                "type": "string",
                "minLength": 1
              },
              "mitigations": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 1
              }
            }
          }
        }
      }
    },
    "detection_hook_contract": {
      "type": "object",
      "required": ["hook_interface", "interception_points", "rules", "hook_timeout_ms"],
      "additionalProperties": true,
      "properties": {
        "description": { "type": "string" },
        "hook_interface": {
          "type": "object",
          "required": ["name", "input", "output"],
          "additionalProperties": true,
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "input": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["field", "type", "description"],
                "additionalProperties": true
              },
              "minItems": 1
            },
            "output": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["field", "type", "description"],
                "additionalProperties": true
              },
              "minItems": 1
            }
          }
        },
        "interception_points": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["id", "description", "mandatory", "applies_to"],
            "additionalProperties": true,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "mandatory": { "type": "boolean" },
              "applies_to": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 1
              }
            }
          }
        },
        "rules": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "hook_timeout_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "rejection_rules": {
      "type": "object",
      "required": ["rules", "max_flagged_per_session"],
      "additionalProperties": true,
      "properties": {
        "description": { "type": "string" },
        "rules": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": ["id", "trigger", "action"],
            "additionalProperties": true,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "trigger": { "type": "string", "minLength": 1 },
              "action": { "type": "string", "minLength": 1 }
            }
          }
        },
        "max_flagged_per_session": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "audit_obligations": {
      "type": "object",
      "required": ["on_block", "on_flag", "on_policy_update", "retention"],
      "additionalProperties": true,
      "properties": {
        "description": { "type": "string" },
        "on_block": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "on_flag": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "on_policy_update": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "retention": {
          "type": "object",
          "required": ["injection_detection_events_days"],
          "additionalProperties": true,
          "properties": {
            "injection_detection_events_days": {
              "type": "integer",
              "minimum": 1
            },
            "description": { "type": "string" }
          }
        }
      }
    }
  }
}
