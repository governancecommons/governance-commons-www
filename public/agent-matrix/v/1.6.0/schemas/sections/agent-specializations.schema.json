{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governancecommons.org/agent-matrix/v/1.4.0/schemas/sections/agent-specializations.schema.json",
  "title": "Agent Specialization",
  "type": "object",
  "required": ["id", "extends", "display_name"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^spec-[a-z][a-z0-9-]*$"
    },
    "extends": { "type": "string" },
    "display_name": { "type": "string" },
    "languages": {
      "type": "array",
      "items": { "type": "string" }
    },
    "frameworks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "focus_areas": {
      "type": "array",
      "items": { "type": "string" }
    },
    "additional_capabilities": {
      "type": "array",
      "items": { "type": "string" }
    },
    "preferred_sku": { "type": "string" },
    "routing_weight": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "required_trust": {
      "type": "string",
      "enum": ["T0", "T1", "T2", "T3", "T4"]
    },
    "stability_acknowledgment_required": { "type": "boolean" }
  }
}
