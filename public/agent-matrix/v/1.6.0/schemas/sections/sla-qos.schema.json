{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governancecommons.org/agent-matrix/v/1.4.0/schemas/sections/sla-qos.schema.json",
  "title": "SLA and QoS",
  "description": "Service-level objectives, indicators, error budgets, and breach events for agent execution.",
  "type": "object",
  "required": ["slo_profiles", "breach_events"],
  "additionalProperties": false,
  "properties": {
    "slo_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "scope", "objectives", "indicators"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "scope": {
            "type": "object",
            "required": ["applies_to"],
            "additionalProperties": false,
            "properties": {
              "applies_to": {
                "type": "string",
                "enum": ["matrix", "agent-profile", "critical-path", "capability-class"]
              },
              "agent_profile": { "type": "string" },
              "critical_path": { "type": "string" },
              "capability_class": {
                "type": "string",
                "enum": ["C1", "C2", "C3", "C4"]
              }
            }
          },
          "objectives": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "availability_target": { "type": "number", "minimum": 0, "maximum": 1 },
              "success_rate_target": { "type": "number", "minimum": 0, "maximum": 1 },
              "p50_latency_ms": { "type": "integer", "minimum": 1 },
              "p95_latency_ms": { "type": "integer", "minimum": 1 },
              "p99_latency_ms": { "type": "integer", "minimum": 1 },
              "throughput_per_minute": { "type": "integer", "minimum": 1 }
            }
          },
          "indicators": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "signal_id"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "signal_id": { "type": "string" },
                "aggregation": {
                  "type": "string",
                  "enum": ["count", "rate", "ratio", "percentile", "sum"]
                }
              }
            }
          },
          "error_budget": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "window_days": { "type": "integer", "minimum": 1 },
              "allowed_failure_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
              "exhaustion_action": { "type": "string" }
            }
          }
        }
      }
    },
    "breach_events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["event_id", "trigger", "severity", "actions"],
        "additionalProperties": false,
        "properties": {
          "event_id": { "type": "string" },
          "trigger": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["warning", "error", "critical"]
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "emit_signal": { "type": "string" }
        }
      }
    }
  }
}
