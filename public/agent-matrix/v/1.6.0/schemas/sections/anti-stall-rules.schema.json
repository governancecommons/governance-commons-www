{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governancecommons.org/agent-matrix/v/1.4.0/schemas/sections/anti-stall-rules.schema.json",
  "title": "Anti-Stall Rules",
  "description": "Rules for detecting and recovering stalled agents. Aligned with agent-dossier anti_stall_rules.",
  "type": "object",
  "required": ["max_idle_ms", "heartbeat_interval_ms", "rules", "on_stall_event"],
  "additionalProperties": false,
  "properties": {
    "max_idle_ms": {
      "type": "integer",
      "minimum": 1000
    },
    "heartbeat_interval_ms": {
      "type": "integer",
      "minimum": 500
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "blocked_state_required_fields", "actions"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^asr-[0-9]{3,}$"
          },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "blocked_state_required_fields": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                { "type": "string" },
                {
                  "type": "object",
                  "additionalProperties": {
                    "type": ["string", "number", "boolean", "array", "object", "null"]
                  }
                }
              ]
            }
          },
          "escalate_after_ms": { "type": "integer", "minimum": 1 },
          "sla_response_hours": { "type": "integer", "minimum": 1 },
          "tool_call_timeout_ms": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "on_stall_event": {
      "type": "object",
      "required": ["emit_signal", "alert_orchestrator"],
      "additionalProperties": false,
      "properties": {
        "emit_signal": { "type": "boolean" },
        "signal_level": {
          "type": "string",
          "enum": ["debug", "info", "warning", "error", "critical"]
        },
        "alert_orchestrator": { "type": "boolean" }
      }
    }
  }
}
