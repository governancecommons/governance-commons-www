---
const standards = [
  {
    name: "Agent Dossier",
    repo: "agent-dossier",
    version: "1.4.0",
    license: "Apache-2.0",
    status: "Stable",
    scope: "Per-agent identity, authority, handoff, telemetry, and audit contract.",
    details: "A portable declaration of an agent's permissions, constraints, failure handling, and interoperability rules before work begins.",
    href: "https://github.com/governancecommons/agent-dossier",
  },
  {
    name: "Agent Matrix",
    repo: "agent-matrix",
    version: "1.6.0",
    license: "MIT",
    status: "Stable",
    scope: "Multi-agent capability, routing, trust, safety, and coordination model.",
    details: "Defines how agent profiles are routed, trusted, observed, recovered, and composed across orchestrated AI systems.",
    href: "https://github.com/governancecommons/agent-matrix",
  },
  {
    name: "Ontic Namespace Structure",
    repo: "ons",
    version: "1.4.0",
    license: "MIT",
    status: "Stable",
    scope: "Naming grammar, namespace identity, collision rules, and validation rule IDs.",
    details: "Makes names canonical across projects by governing separators, casing contracts, registries, and collision scopes.",
    href: "https://github.com/governancecommons/ons",
  },
  {
    name: "Project Orchestrator Agent",
    repo: "agent-project-orchestrator",
    version: "1.x",
    license: "Spec work",
    status: "Draft",
    scope: "Runtime execution contract for project-level orchestrators.",
    details: "Defines goal intake, task graphs, dispatch, governance checks, handoffs, recovery, telemetry, and auditable results.",
    href: "https://github.com/governancecommons/agent-project-orchestrator",
  },
];

const skus = [
  {
    label: "Standard",
    name: "Conformance Starter",
    copy: "Adopt one Governance Commons standard with versioned schemas, examples, and validation expectations.",
    items: ["Standard selection", "Schema reference map", "Conformance checklist"],
  },
  {
    label: "Program",
    name: "Governed Agent Stack",
    copy: "Combine Agent Dossier, Agent Matrix, and ONS into a practical governance baseline for multi-agent delivery.",
    items: ["Per-agent contracts", "Routing and trust model", "Naming governance"],
  },
  {
    label: "Runtime",
    name: "Orchestrator Readiness",
    copy: "Prepare a project-level orchestrator to accept goals, dispatch work, enforce checks, and preserve audit evidence.",
    items: ["Task graph contract", "Handoff protocol", "Telemetry expectations"],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Governance Commons | AI Agent Governance Standards</title>
    <meta
      name="description"
      content="Governance Commons is a suite of interoperable AI agent governance standards: Agent Dossier, Agent Matrix, ONS, and Project Orchestrator Agent."
    />
    <meta property="og:title" content="Governance Commons" />
    <meta
      property="og:description"
      content="Project-neutral standards and deployable adoption paths for governed AI agent ecosystems."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://governancecommons.org" />
    <meta property="og:image" content="https://governancecommons.org/assets/governance-hero.png" />
    <link rel="icon" href="data:," />
  </head>
  <body>
    <header class="site-header" data-elevate>
      <a class="brand" href="#top" aria-label="Governance Commons home">
        <span class="brand-mark" aria-hidden="true">GC</span>
        <span>Governance Commons</span>
      </a>
      <nav class="site-nav" aria-label="Primary navigation">
        <a href="#standards">Standards</a>
        <a href="#skus">SKUs</a>
        <a href="#deploy">Deploy</a>
        <a href="#contact">Contact</a>
      </nav>
      <a class="header-action" href="https://github.com/governancecommons">GitHub</a>
    </header>

    <main id="top">
      <section class="hero" aria-labelledby="hero-title">
        <img
          class="hero-image"
          src="/assets/governance-hero.png"
          alt="Modular AI governance controls, repositories, and audit systems arranged as connected infrastructure"
        />
        <div class="hero-scrim" aria-hidden="true"></div>
        <div class="hero-content">
          <p class="eyebrow">Governancecommons.org</p>
          <h1 id="hero-title">Governance Commons</h1>
          <p class="hero-copy">
            Four interoperable, project-neutral standards for governed AI agent systems:
            per-agent contracts, multi-agent coordination, canonical naming, and runtime
            orchestration.
          </p>
          <div class="hero-actions">
            <a class="button primary" href="#standards">Explore standards</a>
            <a class="button secondary" href="#skus">View SKUs</a>
          </div>
        </div>
        <aside class="hero-panel" aria-label="Governance Commons summary">
          <div>
            <span class="metric">4</span>
            <span class="metric-label">portable standards</span>
          </div>
          <div>
            <span class="metric">3</span>
            <span class="metric-label">stable specs</span>
          </div>
          <div>
            <span class="metric">1</span>
            <span class="metric-label">runtime contract</span>
          </div>
        </aside>
      </section>

      <section class="section intro-section">
        <div class="section-heading">
          <p class="eyebrow">The commons</p>
          <h2>Governance that agents can actually carry into work.</h2>
        </div>
        <div class="intro-grid">
          <article>
            <h3>Independently versioned</h3>
            <p>
              Each standard can be adopted alone or together, with its own schemas,
              examples, conformance expectations, and changelog.
            </p>
          </article>
          <article>
            <h3>Project-neutral</h3>
            <p>
              The commons defines portable contracts and validation surfaces without
              embedding project-specific business logic or runtime implementation details.
            </p>
          </article>
          <article>
            <h3>Audit-oriented</h3>
            <p>
              Dossiers, handoffs, routing choices, naming records, runtime checks, and
              recovery paths are designed to preserve clear evidence.
            </p>
          </article>
        </div>
      </section>

      <section id="standards" class="section standards-section">
        <div class="section-heading">
          <p class="eyebrow">Standards</p>
          <h2>The four layers of governed agent software.</h2>
        </div>
        <div class="standards-grid">
          {
            standards.map((standard) => (
              <article class="standard-card">
                <div class="standard-topline">
                  <span>{standard.status}</span>
                  <span>{standard.version}</span>
                </div>
                <h3>{standard.name}</h3>
                <p>{standard.scope}</p>
                <p class="standard-detail">{standard.details}</p>
                <div class="standard-footer">
                  <code>{standard.repo}</code>
                  <a href={standard.href}>Repository</a>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section id="skus" class="section sku-section">
        <div class="section-heading narrow">
          <p class="eyebrow">Deployable SKUs</p>
          <h2>Adoption paths for teams moving from specs to practice.</h2>
        </div>
        <div class="sku-grid">
          {
            skus.map((sku, index) => (
              <article class:list={["sku-card", { featured: index === 1 }]}>
                <p class="sku-kicker">{sku.label}</p>
                <h3>{sku.name}</h3>
                <p>{sku.copy}</p>
                <ul>
                  {sku.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </section>

      <section id="deploy" class="section deploy-section">
        <div class="section-heading">
          <p class="eyebrow">Domain and hosting</p>
          <h2>Built for GitHub, Netlify DNS, and the Namecheap registrar path.</h2>
        </div>
        <div class="deploy-list">
          <article>
            <span>01</span>
            <h3>GitHub is the source of truth</h3>
            <p>Code and standard repositories remain in GitHub with Netlify building this Astro site from the website repo.</p>
          </article>
          <article>
            <span>02</span>
            <h3>Netlify serves and manages DNS</h3>
            <p>The site build publishes `dist/`, with DNS records managed in Netlify for `governancecommons.org` and `www` redirection.</p>
          </article>
          <article>
            <span>03</span>
            <h3>Namecheap points nameservers</h3>
            <p>The registrar keeps ownership of the domain while delegating DNS to the Netlify nameservers assigned to the site.</p>
          </article>
        </div>
      </section>

      <section id="contact" class="section contact-section">
        <div class="contact-copy">
          <p class="eyebrow">Governancecommons.org</p>
          <h2>A commons of portable specifications, not a single runtime.</h2>
          <p>
            Use the standards separately or as a layered governance stack for AI agent
            delivery, assurance, naming, coordination, and project-level orchestration.
          </p>
        </div>
        <div class="contact-actions">
          <a class="button primary" href="mailto:hello@governancecommons.org">hello@governancecommons.org</a>
          <a class="button secondary light" href="https://github.com/governancecommons">GitHub org</a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <span>© {new Date().getFullYear()} Governance Commons</span>
      <span>AI agent governance standards and SKUs</span>
    </footer>

    <script>
      const header = document.querySelector("[data-elevate]");
      const updateHeader = () => {
        header?.classList.toggle("is-elevated", window.scrollY > 8);
      };

      updateHeader();
      window.addEventListener("scroll", updateHeader, { passive: true });
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --ink: #111713;
    --muted: #5c665f;
    --paper: #f7f7f1;
    --white: #ffffff;
    --green: #124234;
    --green-soft: #d8eee4;
    --gold: #c78a2d;
    --blue: #315d8f;
    --graphite: #252a28;
    --line: rgba(17, 23, 19, 0.14);
    --shadow: 0 22px 70px rgba(17, 23, 19, 0.18);
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  code {
    background: rgba(18, 66, 52, 0.08);
    border-radius: 6px;
    color: var(--green);
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: 0.9em;
    padding: 4px 7px;
  }

  .site-header {
    align-items: center;
    background: rgba(247, 247, 241, 0.9);
    border-bottom: 1px solid rgba(17, 23, 19, 0.08);
    display: grid;
    gap: 24px;
    grid-template-columns: 1fr auto auto;
    left: 0;
    padding: 16px clamp(18px, 4vw, 56px);
    position: fixed;
    right: 0;
    top: 0;
    transition: box-shadow 180ms ease, background 180ms ease;
    z-index: 20;
  }

  .site-header.is-elevated {
    background: rgba(247, 247, 241, 0.98);
    box-shadow: 0 10px 30px rgba(17, 23, 19, 0.08);
  }

  .brand,
  .site-nav,
  .hero-actions,
  .contact-actions {
    align-items: center;
    display: flex;
  }

  .brand {
    font-weight: 760;
    gap: 10px;
  }

  .brand-mark {
    align-items: center;
    background: var(--green);
    border-radius: 6px;
    color: var(--white);
    display: inline-flex;
    font-size: 0.78rem;
    height: 34px;
    justify-content: center;
    width: 34px;
  }

  .site-nav {
    color: #39413c;
    font-size: 0.94rem;
    gap: 22px;
  }

  .site-nav a,
  .header-action {
    border-radius: 6px;
    padding: 8px 2px;
  }

  .site-nav a:hover,
  .header-action:hover {
    color: var(--green);
  }

  .header-action {
    border: 1px solid var(--line);
    font-weight: 680;
    padding: 9px 14px;
  }

  .hero {
    min-height: 94vh;
    overflow: hidden;
    padding: 132px clamp(18px, 5vw, 72px) 46px;
    position: relative;
  }

  .hero-image,
  .hero-scrim {
    inset: 0;
    position: absolute;
  }

  .hero-image {
    height: 100%;
    object-fit: cover;
    width: 100%;
    z-index: 0;
  }

  .hero-scrim {
    background:
      linear-gradient(90deg, rgba(5, 15, 12, 0.82) 0%, rgba(5, 15, 12, 0.58) 38%, rgba(5, 15, 12, 0.18) 78%),
      linear-gradient(0deg, rgba(5, 15, 12, 0.74) 0%, rgba(5, 15, 12, 0) 38%);
    z-index: 1;
  }

  .hero-content {
    color: var(--white);
    max-width: 820px;
    position: relative;
    z-index: 2;
  }

  .eyebrow {
    color: var(--gold);
    font-size: 0.78rem;
    font-weight: 760;
    letter-spacing: 0;
    margin: 0 0 13px;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    font-size: clamp(3.3rem, 9vw, 8.6rem);
    line-height: 0.9;
    margin-bottom: 26px;
    max-width: 820px;
  }

  .hero-copy {
    color: rgba(255, 255, 255, 0.88);
    font-size: clamp(1.06rem, 1.8vw, 1.38rem);
    line-height: 1.55;
    margin-bottom: 30px;
    max-width: 700px;
  }

  .button {
    align-items: center;
    border-radius: 7px;
    display: inline-flex;
    font-weight: 760;
    justify-content: center;
    min-height: 46px;
    padding: 12px 18px;
    transition: transform 160ms ease, box-shadow 160ms ease, background 160ms ease;
  }

  .button:hover {
    transform: translateY(-1px);
  }

  .button.primary {
    background: var(--gold);
    color: #1b1308;
    box-shadow: 0 14px 36px rgba(199, 138, 45, 0.28);
  }

  .button.secondary {
    border: 1px solid rgba(255, 255, 255, 0.42);
    color: var(--white);
  }

  .button.secondary.light {
    border-color: rgba(255, 255, 255, 0.44);
  }

  .hero-actions,
  .contact-actions {
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero-panel {
    align-items: stretch;
    background: rgba(247, 247, 241, 0.92);
    border: 1px solid rgba(255, 255, 255, 0.42);
    border-radius: 8px;
    bottom: 34px;
    box-shadow: var(--shadow);
    color: var(--ink);
    display: grid;
    gap: 1px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: 560px;
    overflow: hidden;
    position: absolute;
    right: clamp(18px, 5vw, 72px);
    z-index: 3;
  }

  .hero-panel div {
    background: rgba(255, 255, 255, 0.72);
    padding: 18px;
  }

  .metric {
    display: block;
    font-size: 2rem;
    font-weight: 820;
    line-height: 1;
  }

  .metric-label {
    color: var(--muted);
    display: block;
    font-size: 0.86rem;
    line-height: 1.25;
    margin-top: 7px;
  }

  .section {
    padding: clamp(62px, 8vw, 108px) clamp(18px, 5vw, 72px);
  }

  .section-heading {
    display: grid;
    gap: 24px;
    grid-template-columns: minmax(220px, 0.8fr) minmax(280px, 1.2fr);
    margin: 0 auto 34px;
    max-width: 1180px;
  }

  .section-heading.narrow {
    display: block;
    max-width: 820px;
    text-align: center;
  }

  .section-heading h2,
  .contact-copy h2 {
    font-size: clamp(2rem, 4vw, 4.4rem);
    line-height: 1.02;
    margin-bottom: 0;
  }

  .intro-grid,
  .sku-grid {
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0 auto;
    max-width: 1180px;
  }

  .intro-grid article,
  .sku-card,
  .standard-card,
  .deploy-list article {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 28px;
  }

  .intro-grid h3,
  .sku-card h3,
  .standard-card h3,
  .deploy-list h3 {
    font-size: 1.28rem;
    margin-bottom: 12px;
  }

  .intro-grid p,
  .sku-card p,
  .standard-card p,
  .deploy-list p,
  .contact-copy p {
    color: var(--muted);
    line-height: 1.62;
  }

  .standards-section,
  .repo-section {
    background: var(--white);
  }

  .standards-grid {
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0 auto;
    max-width: 1180px;
  }

  .standard-card {
    background: var(--paper);
    display: flex;
    flex-direction: column;
    min-height: 330px;
  }

  .standard-topline,
  .standard-footer {
    align-items: center;
    display: flex;
    justify-content: space-between;
  }

  .standard-topline {
    color: var(--blue);
    font-size: 0.78rem;
    font-weight: 800;
    margin-bottom: 30px;
    text-transform: uppercase;
  }

  .standard-detail {
    margin-bottom: 26px;
  }

  .standard-footer {
    border-top: 1px solid var(--line);
    margin-top: auto;
    padding-top: 18px;
  }

  .standard-footer a {
    color: var(--green);
    font-weight: 800;
  }

  .sku-section,
  .deploy-section {
    background: #ecefe7;
  }

  .sku-card {
    min-height: 350px;
    position: relative;
  }

  .sku-card.featured {
    background: var(--green);
    color: var(--white);
  }

  .sku-card.featured p,
  .sku-card.featured li {
    color: rgba(255, 255, 255, 0.78);
  }

  .sku-kicker {
    color: var(--blue);
    font-size: 0.78rem;
    font-weight: 800;
    margin-bottom: 14px;
    text-transform: uppercase;
  }

  .sku-card.featured .sku-kicker {
    color: var(--gold);
  }

  .sku-card ul {
    border-top: 1px solid rgba(17, 23, 19, 0.12);
    display: grid;
    gap: 12px;
    list-style: none;
    margin: 24px 0 0;
    padding: 18px 0 0;
  }

  .sku-card.featured ul {
    border-top-color: rgba(255, 255, 255, 0.18);
  }

  .sku-card li {
    color: #44504a;
    line-height: 1.4;
    padding-left: 20px;
    position: relative;
  }

  .sku-card li::before {
    background: var(--gold);
    border-radius: 99px;
    content: "";
    height: 7px;
    left: 0;
    position: absolute;
    top: 0.62em;
    width: 7px;
  }

  .deploy-list {
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0 auto;
    max-width: 1180px;
  }

  .deploy-list span {
    color: var(--gold);
    display: block;
    font-weight: 820;
    margin-bottom: 34px;
  }

  .contact-section {
    align-items: center;
    background: var(--green);
    color: var(--white);
    display: grid;
    gap: 32px;
    grid-template-columns: minmax(280px, 1fr) auto;
  }

  .contact-copy {
    max-width: 820px;
  }

  .contact-copy p {
    color: rgba(255, 255, 255, 0.78);
    font-size: 1.08rem;
    margin-bottom: 0;
  }

  .site-footer {
    align-items: center;
    background: #0d1411;
    color: rgba(255, 255, 255, 0.72);
    display: flex;
    font-size: 0.9rem;
    gap: 16px;
    justify-content: space-between;
    padding: 22px clamp(18px, 5vw, 72px);
  }

  @media (max-width: 980px) {
    .site-header {
      gap: 12px;
      grid-template-columns: 1fr auto;
    }

    .site-nav {
      display: none;
    }

    .hero {
      min-height: 98vh;
      padding-top: 110px;
    }

    .hero-panel {
      bottom: 20px;
      left: 18px;
      max-width: none;
      right: 18px;
    }

    .section-heading,
    .intro-grid,
    .sku-grid,
    .standards-grid,
    .deploy-list,
    .contact-section {
      grid-template-columns: 1fr;
    }

    .contact-actions {
      justify-content: flex-start;
    }
  }

  @media (max-width: 620px) {
    .brand span:last-child {
      max-width: 160px;
    }

    .header-action {
      padding-inline: 10px;
    }

    h1 {
      font-size: 3.25rem;
    }

    .hero-copy {
      font-size: 1rem;
    }

    .hero-panel {
      grid-template-columns: 1fr;
    }

    .hero-panel div {
      padding: 12px 14px;
    }

    .metric {
      display: inline;
      font-size: 1.35rem;
      margin-right: 8px;
    }

    .metric-label {
      display: inline;
    }

    .intro-grid article,
    .sku-card,
    .standard-card,
    .deploy-list article {
      padding: 22px;
    }

    .standard-card {
      min-height: 0;
    }

    .standard-footer {
      align-items: flex-start;
      flex-direction: column;
      gap: 12px;
    }

    .site-footer {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
