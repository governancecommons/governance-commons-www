{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governancecommons.org/agent-matrix/v/1.4.0/schemas/sections/task-routing-rules.schema.json",
  "title": "Task Routing Rules",
  "type": "object",
  "required": ["default_routing_strategy", "fallback_agent", "rules"],
  "additionalProperties": false,
  "properties": {
    "default_routing_strategy": {
      "type": "string",
      "enum": ["capability-first", "trust-first", "cost-first", "latency-first"]
    },
    "fallback_agent": {
      "type": "string",
      "description": "Agent profile ID to use when no routing rule matches."
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "priority", "match", "assign_to"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "description": "Lower numbers = higher priority."
          },
          "match": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "task_type": { "type": "string" },
              "any_tag": {
                "type": "array",
                "items": { "type": "string" }
              },
              "task_criticality": { "type": "string" }
            }
          },
          "assign_to": {
            "type": "string",
            "description": "Agent profile ID to assign matching tasks to."
          },
          "constraints": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "require_capability": { "type": "string" },
              "require_trust": {
                "type": "string",
                "enum": ["T0", "T1", "T2", "T3", "T4"]
              },
              "max_duration_seconds": { "type": "integer", "minimum": 1 },
              "max_context_tokens": { "type": "integer", "minimum": 1 },
              "output_schema": { "type": "string" }
            }
          }
        }
      }
    },
    "load_balancing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "type": "string",
          "enum": ["round-robin", "least-loaded", "affinity", "random"]
        },
        "health_check_interval_seconds": { "type": "integer", "minimum": 1 },
        "circuit_breaker": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "failure_threshold": { "type": "integer", "minimum": 1 },
            "recovery_timeout_seconds": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}
