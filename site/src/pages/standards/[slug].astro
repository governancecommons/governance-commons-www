---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { components, type Component } from "../../data/standards";

export function getStaticPaths() {
  return components.map((component) => ({ params: { slug: component.slug }, props: { component } }));
}

interface Props { component: Component; }
const { component } = Astro.props;
---

<BaseLayout title={`${component.name} | Governance Commons`} description={component.scope}>
  <section class="page-hero">
    <div class="page-title">
      <p class="eyebrow">{component.category}</p>
      <h1>{component.name}</h1>
      <p class="lede">{component.summary}</p>
      <div class="meta-row"><span>{component.role}</span><span>v{component.version}</span><span>{component.maturity}</span><span>{component.license}</span></div>
    </div>
  </section>
  <section class="section white">
    <div class="section-inner detail-grid">
      <div>
        <section class="detail-block"><p class="eyebrow">Status</p><h2>{component.baseline}</h2><p>{component.scope}</p></section>
        <section class="detail-block"><p class="eyebrow">Capabilities</p><h2>What this component covers.</h2><ul class="check-list">{component.capabilities.map((item) => <li>{item}</li>)}</ul></section>
        <section class="detail-block"><p class="eyebrow">Use path</p><h2>Make a scoped, versioned claim.</h2><ol class="number-list">{component.adoption.map((item) => <li>{item}</li>)}</ol></section>
        <section class="detail-block"><p class="eyebrow">Evidence boundary</p><h2>Declare only what the evidence supports.</h2><p>{component.conformance}</p><a class="text-link" href="/conformance">Read validation and declaration guidance →</a></section>
      </div>
      <aside class="resource-panel">
        <p class="eyebrow">Resources</p>
        <h3>Source and evidence</h3>
        <a class="text-link" href={component.repo}>Source repository →</a>
        {component.resources.map((resource) => <a class="text-link" href={resource.href}>{resource.label} →</a>)}
        <small>Repository ownership, release tags, and linked artifacts remain the authority for this component. Governance Commons does not provide third-party certification.</small>
      </aside>
    </div>
  </section>
</BaseLayout>
