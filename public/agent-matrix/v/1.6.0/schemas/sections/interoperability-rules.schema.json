{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governancecommons.org/agent-matrix/v/1.4.0/schemas/sections/interoperability-rules.schema.json",
  "title": "Agent Interoperability Rules",
  "type": "object",
  "required": [
    "protocol_version",
    "message_format",
    "encoding",
    "required_message_fields",
    "payload_types",
    "interoperability_policies"
  ],
  "additionalProperties": false,
  "properties": {
    "protocol_version": { "type": "string" },
    "message_format": {
      "type": "string",
      "enum": ["json", "yaml", "msgpack"]
    },
    "encoding": { "type": "string" },
    "required_message_fields": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "payload_types": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "interoperability_policies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "required"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "required": { "type": "boolean" },
          "algorithm": { "type": "string" }
        }
      }
    },
    "cross-vendor-agents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed": { "type": "boolean" },
        "requires": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "additionalProperties": {
                  "type": ["string", "number", "boolean", "array", "object", "null"]
                }
              }
            ]
          }
        },
        "restrictions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
