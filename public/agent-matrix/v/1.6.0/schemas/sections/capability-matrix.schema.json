{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governancecommons.org/agent-matrix/v/1.4.0/schemas/sections/capability-matrix.schema.json",
  "title": "Capability Matrix",
  "type": "object",
  "required": ["classes"],
  "additionalProperties": false,
  "properties": {
    "classes": {
      "type": "object",
      "description": "Map of capability class ID to class definition.",
      "patternProperties": {
        "^C[1-4]$": {
          "type": "object",
          "required": ["name", "description", "capabilities"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "description": { "type": "string" },
            "stability_acknowledgment_required": { "type": "boolean" },
            "capabilities": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["id", "name", "description", "requires_trust"],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^c[1-4]\\.[a-z][a-z0-9-]*$"
                  },
                  "name": { "type": "string" },
                  "description": { "type": "string" },
                  "requires_trust": {
                    "type": "string",
                    "enum": ["T0", "T1", "T2", "T3", "T4"]
                  }
                }
              }
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
