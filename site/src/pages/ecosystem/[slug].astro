---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { ecosystemProfiles } from "../../data/ecosystemProfiles";
export function getStaticPaths() { return ecosystemProfiles.map((profile) => ({params:{slug:profile.slug},props:{profile}})); }
const { profile } = Astro.props;
---
<BaseLayout title={profile.name + " | AI Governance Ecosystem | Governance Commons"} description={profile.offering}>
<section class="section white" style="padding-top:150px">
  <div class="section-heading">
    <p class="eyebrow">Ecosystem / Independent reference profile</p>
    <h1 style="font-size:clamp(2.5rem,6vw,5rem)">{profile.name}</h1>
    <p>{profile.type}</p>
  </div>
  <div class="intro-grid">
    <article class="surface"><h2>What they offer</h2><p>{profile.offering}</p></article>
    <article class="surface"><h2>Relationship to GC</h2><p>{profile.relation}</p></article>
    <article class="surface"><h2>Primary sources</h2><p><a class="text-link" href={profile.url}>Official organization resource →</a></p><p><a class="text-link" href={profile.source}>Further official documentation →</a></p></article>
  </div>
  <div class="surface notice" style="margin-top:28px"><strong>Editorial status:</strong> Initial source-linked orientation. Detailed version-by-version crosswalk and independent source verification are pending. No formal relationship, certification, endorsement, or interoperability is asserted.</div>
  <div class="actions" style="margin-top:24px"><a class="button ink" href="/ecosystem">← Back to ecosystem directory</a></div>
</section>
</BaseLayout>