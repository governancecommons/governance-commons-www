{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governancecommons.org/agent-matrix/v/1.4.0/schemas/sections/recovery-rules.schema.json",
  "title": "Agent Recovery Rules",
  "type": "object",
  "required": ["rules"],
  "additionalProperties": false,
  "properties": {
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "applies_to_failure", "strategy"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "applies_to_failure": {
            "type": "array",
            "items": { "type": "string", "pattern": "^FM-[0-9]{3,}$" }
          },
          "strategy": { "type": "string" },
          "action": { "type": "string" },
          "max_retries": { "type": "integer", "minimum": 0 },
          "initial_delay_seconds": { "type": "integer", "minimum": 0 },
          "backoff_multiplier": { "type": "number", "minimum": 1 },
          "jitter": { "type": "boolean" },
          "max_decomposition_depth": { "type": "integer", "minimum": 1 },
          "checkpoint_staleness_limit_seconds": { "type": "integer", "minimum": 1 },
          "audit_required": { "type": "boolean" },
          "resume_requires": { "type": "string" },
          "on_max_retries_exceeded": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "action": { "type": "string" }
            }
          },
          "on_no_capable_agent": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "action": { "type": "string" }
            }
          },
          "on_failure": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "action": { "type": "string" }
            }
          },
          "on_stale_checkpoint": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "action": { "type": "string" }
            }
          },
          "escalation_level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3,
            "description": "Escalation protocol level to invoke after applying this recovery action."
          }
        }
      }
    }
  }
}
