{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governancecommons.org/agent-matrix/v/1.4.0/schemas/sections/versioning.schema.json",
  "title": "Versioning",
  "type": "object",
  "required": ["matrix_version", "schema_version", "specification_version", "created_at", "stability", "compatibility_table"],
  "additionalProperties": false,
  "properties": {
    "matrix_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "specification_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "The matrix specification version this document conforms to."
    },
    "dossier_specification_alignment": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "The agent-dossier spec version this matrix aligns with."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "stability": {
      "type": "string",
      "enum": ["experimental", "beta", "stable", "deprecated"]
    },
    "breaking_change_policy": { "type": "string" },
    "compatibility_table": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["matrix_version", "min_orchestrator_version", "status"],
        "additionalProperties": false,
        "properties": {
          "matrix_version": { "type": "string" },
          "min_orchestrator_version": { "type": "string" },
          "min_dossier_schema_version": { "type": "string" },
          "dossier_specification_alignment": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["current", "supported", "deprecated", "removed"]
          }
        }
      }
    }
  }
}
