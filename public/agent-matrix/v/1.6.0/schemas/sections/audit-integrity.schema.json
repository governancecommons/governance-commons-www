{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governancecommons.org/agent-matrix/v/1.4.0/schemas/sections/audit-integrity.schema.json",
  "title": "Audit Integrity",
  "description": "Tamper-evident audit log schema, hash chaining, export, retention enforcement, and verification.",
  "type": "object",
  "required": ["log_schema", "hash_chain", "export", "retention_enforcement"],
  "additionalProperties": false,
  "properties": {
    "log_schema": {
      "type": "object",
      "required": ["required_fields", "canonicalization"],
      "additionalProperties": false,
      "properties": {
        "required_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "canonicalization": {
          "type": "string",
          "enum": ["json-canonicalization-scheme", "stable-yaml", "deterministic-json"]
        }
      }
    },
    "hash_chain": {
      "type": "object",
      "required": ["enabled", "hash_algorithm", "entry_hash_field", "previous_hash_field"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "hash_algorithm": { "type": "string" },
        "entry_hash_field": { "type": "string" },
        "previous_hash_field": { "type": "string" },
        "anchor_policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "interval_seconds": { "type": "integer", "minimum": 1 },
            "anchor_target": { "type": "string" }
          }
        }
      }
    },
    "export": {
      "type": "object",
      "required": ["formats", "include_verification_manifest"],
      "additionalProperties": false,
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["jsonl", "parquet", "csv", "signed-bundle"]
          }
        },
        "include_verification_manifest": { "type": "boolean" },
        "signing_algorithm": { "type": "string" }
      }
    },
    "retention_enforcement": {
      "type": "object",
      "required": ["policy_source", "deletion_mode", "legal_hold_tag"],
      "additionalProperties": false,
      "properties": {
        "policy_source": { "type": "string" },
        "deletion_mode": {
          "type": "string",
          "enum": ["tombstone", "hard-delete-after-export", "archive-only"]
        },
        "legal_hold_tag": { "type": "string" },
        "enforcement_interval_hours": { "type": "integer", "minimum": 1 }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verify_on_read": { "type": "boolean" },
        "verification_failure_action": { "type": "string" },
        "sample_rate": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
